# ─────────────────────────────────────────────
# Synthetic Client Survey Lab - 환경변수 예시
# 이 파일을 .env 로 복사해서 사용하세요.
# (.env 는 앱과 Prisma CLI 가 모두 읽습니다. git 에는 커밋되지 않습니다.)
# ─────────────────────────────────────────────

# 로컬 SQLite 데이터베이스 경로
DATABASE_URL="file:./dev.db"

# AI Provider API Key (서버에서만 사용, 브라우저로 전달되지 않음)
# Mock 모드만 사용할 경우 모두 비워두어도 됩니다.

# Google Gemini (https://aistudio.google.com/apikey 에서 발급)
GEMINI_API_KEY=

# OpenAI (또는 OpenAI 호환 API)
OPENAI_API_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=

# 엔드포인트를 바꿔야 할 때만 수정하세요.
OPENAI_BASE_URL="https://api.openai.com/v1"
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"

# Gemini 2.5 계열 내부 추론(thinking) 토큰 예산. 기본 0(사용 안 함).
# 응답 품질을 높이고 싶으면 1024 등으로 올릴 수 있으나 비용이 늘어납니다.
# GEMINI_THINKING_BUDGET=0

# 기본 Provider: mock | gemini | openai | anthropic
DEFAULT_LLM_PROVIDER="mock"
DEFAULT_LLM_MODEL="mock-deterministic-v1"
